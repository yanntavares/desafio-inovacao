# Copie para .env e ajuste. Nunca commitar o .env.
POSTGRES_USER=handoff
POSTGRES_PASSWORD=handoff
POSTGRES_DB=handoff

# Dentro do docker compose o host do banco é "db"
DATABASE_URL=postgresql+psycopg://handoff:handoff@db:5432/handoff

# Provedor de IA: "mock" (padrão, sem custo) ou "anthropic" (Claude; chamadas pagas)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODELO=claude-sonnet-5-5
LLM_EFFORT=medium

# Limites (LLM_MAX_TOKENS cobre o raciocínio + a resposta)
LLM_MAX_TOKENS=16000
MAX_TRANSCRIPT_WORDS=15000
EXTRACTION_MAX_REPAIRS=2

# Fora do modo demo a API não sobe com este valor: use 32+ caracteres (openssl rand -hex 32)
JWT_SECRET=troque-isto

# Portas no host (opcional)
# API_PORT=8000
# FRONTEND_PORT=3000
# DB_PORT=5432
JWT_EXPIRA_MINUTOS=480
EMAIL_DOMINIO=seedabit.org.br
# Modo demonstração: login com perfis fictícios e recarga do seed. Nunca ligar em produção.
DEMO_MODE=true
