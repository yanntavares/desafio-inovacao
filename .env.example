# Copie para .env e ajuste. Nunca commitar o .env.
POSTGRES_USER=handoff
POSTGRES_PASSWORD=handoff
POSTGRES_DB=handoff

# Dentro do docker compose o host do banco é "db"
DATABASE_URL=postgresql+psycopg://handoff:handoff@db:5432/handoff

# Provedor de IA: "mock" (padrão, sem custo) ou "anthropic" / "openai"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Limites
LLM_MAX_TOKENS=4000
MAX_TRANSCRIPT_WORDS=15000
EXTRACTION_MAX_REPAIRS=2

JWT_SECRET=troque-isto
